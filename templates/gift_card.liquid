{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ gift_card.balance | money }} — {{ shop.name }}</title>
    {{ content_for_header }}
  </head>
  <body>
    <p>{{ shop.name }}</p>
    <p>{{ gift_card.balance | money }}</p>
    <p>{{ gift_card.code | format_code }}</p>
    <a href="{{ shop.url }}">{{ 'gift_cards.shop_now' | t }}</a>
  </body>
</html>
