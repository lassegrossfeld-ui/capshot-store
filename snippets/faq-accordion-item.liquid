{% doc %}
Single FAQ accordion row with animated panel.
@param {number} index - Unique id suffix for aria wiring
@param {string} question_key - Locale key for the question
@param {string} answer_key - Locale key for the answer
{% enddoc %}

<div class="faq-item" data-faq-item>
  <button
    type="button"
    class="faq-item__trigger"
    id="faq-trigger-{{ index }}"
    data-faq-trigger
    aria-expanded="false"
    aria-controls="faq-panel-{{ index }}"
  >
    <span class="faq-item__q">{{ question_key | t }}</span>
    <span class="faq-item__icon" aria-hidden="true"></span>
  </button>
  <div
    class="faq-item__panel"
    id="faq-panel-{{ index }}"
    role="region"
    aria-labelledby="faq-trigger-{{ index }}"
  >
    <div class="faq-item__panel-inner">
      <p>{{ answer_key | t }}</p>
    </div>
  </div>
</div>
