<section class="section">
  <div class="page-width page-hero">
    <h1>{{ 'password.heading' | t }}</h1>
    <p class="lede">{{ 'password.text' | t }}</p>
    {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
      <div class="field">
        <label for="Password">{{ 'password.login' | t }}</label>
        <input id="Password" type="password" name="password">
      </div>
      <button class="btn btn--primary" type="submit">{{ 'password.login' | t }}</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.password.name",
  "settings": []
}
{% endschema %}
