<section class="section section--why-capshot">
  <div class="page-width why-capshot">
    <h2 class="why-capshot__heading">{{ 'home.why_heading' | t }}</h2>
    <div class="why-capshot__grid">
      <article class="why-capshot__item">
        <div class="why-capshot__icon" aria-hidden="true">
          <svg width="56" height="56" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="8" y="20" width="48" height="28" rx="4"></rect>
            <circle cx="20" cy="34" r="5" fill="var(--color-accent)" stroke="none"></circle>
            <circle cx="44" cy="34" r="5" fill="var(--color-accent)" stroke="none"></circle>
            <path d="M32 12v8"></path>
          </svg>
        </div>
        <h3>{{ 'home.why_1_title' | t }}</h3>
        <p>{{ 'home.why_1_text' | t }}</p>
      </article>
      <article class="why-capshot__item">
        <div class="why-capshot__icon" aria-hidden="true">
          <svg width="56" height="56" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 38c0-6 6-12 14-12s14 6 14 12"></path>
            <circle cx="24" cy="26" r="5"></circle>
            <circle cx="40" cy="26" r="5"></circle>
            <path d="M32 44v8M28 52h8"></path>
            <path fill="var(--color-primary)" stroke="none" d="M44 18c2 0 3 1.5 3 3s-1 3-3 3-3-1.5-3-3 1-3 3-3z"></path>
          </svg>
        </div>
        <h3>{{ 'home.why_2_title' | t }}</h3>
        <p>{{ 'home.why_2_text' | t }}</p>
      </article>
      <article class="why-capshot__item">
        <div class="why-capshot__icon" aria-hidden="true">
          <svg width="56" height="56" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 28h36v22H14z"></path>
            <path d="M22 28V22a10 10 0 0 1 20 0v6"></path>
            <circle cx="32" cy="40" r="7" fill="var(--color-accent)" stroke="none"></circle>
            <path d="M35 37h-4a2 2 0 1 0 0 4h3" stroke="#0a0a0a" stroke-width="1.75"></path>
          </svg>
        </div>
        <h3>{{ 'home.why_3_title' | t }}</h3>
        <p>{{ 'home.why_3_text' | t }}</p>
      </article>
    </div>
  </div>
</section>

