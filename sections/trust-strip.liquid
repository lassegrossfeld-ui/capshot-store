<section class="section section--tight">
  <div class="page-width trust">
    <div class="trust-item">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="7" width="18" height="10" rx="1"></rect></svg>
      <div>
        <strong>{{ 'trust.size_title' | t }}</strong>
        <span>{{ 'trust.size_text' | t }}</span>
      </div>
    </div>
    <div class="trust-item">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 12h16M7 8l-3 4 3 4M17 8l3 4-3 4"></path></svg>
      <div>
        <strong>{{ 'trust.wipe_title' | t }}</strong>
        <span>{{ 'trust.wipe_text' | t }}</span>
      </div>
    </div>
    <div class="trust-item">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v18M5 8h14M8 21h8"></path></svg>
      <div>
        <strong>{{ 'trust.return_title' | t }}</strong>
        <span>{{ 'trust.return_text' | t }}</span>
      </div>
    </div>
    <div class="trust-item">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 7h12v10H3zM15 10h4l2 3v4h-6"></path></svg>
      <div>
        <strong>{{ 'trust.ship_title' | t }}</strong>
        <span>{{ 'trust.ship_text' | t }}</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.trust.name",
  "settings": [],
  "presets": [{ "name": "t:sections.trust.name" }]
}
{% endschema %}
